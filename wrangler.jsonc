// One Worker for the whole game: the built files under ./dist, and the
// ranking API under /api (server/index.ts). Static files are served by
// Cloudflare without running the Worker, so they cost nothing.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exiled-survivors",
  "main": "server/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only the API runs the Worker; everything else is a file.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exiled-survivors",
      "database_id": "2a40220d-d593-4f4b-ac61-babdcea14fba",
      "migrations_dir": "server/migrations"
    }
  ],
  "observability": { "enabled": true }
}
